{
  "name": "@project-operations/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "dev": "tsx watch src/main.ts",
    "generate": "prisma generate",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "prisma generate && vitest run && tsx test/runtime-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "prisma generate && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "cookie-parser": "1.4.7",
    "otplib": "13.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
