{
  "name": "project-operations-center",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:check": "node infra/scripts/run-contract-tests.mjs",
    "db:local": "node infra/scripts/local-postgres.mjs --prepare --",
    "db:local:hold": "node infra/scripts/local-postgres.mjs",
    "lint": "turbo run lint",
    "quality": "prettier --check . && pnpm infra:check && turbo run lint typecheck test --concurrency=1 && turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.9.6",
    "turbo": "2.10.10"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.6.0-beta.19"
  }
}
